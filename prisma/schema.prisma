generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User / Account / Session / VerificationToken follow the Auth.js Prisma adapter shape.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // null = onboarding not completed yet. Length mirrors MOVIE_MAX_LENGTH in src/lib/movie.ts.
  favoriteMovie String?   @db.VarChar(100)

  // Lease for "generation in progress"; see src/lib/facts/service.ts.
  factGenerationStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  facts    MovieFact[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model MovieFact {
  id      String @id @default(cuid())
  userId  String
  // Snapshot of the movie the fact is about, so a later movie change never serves a stale fact.
  movie   String @db.VarChar(100)
  content String @db.VarChar(1000)
  // Set by the app clock (not DB default) so cache-age math uses a single clock.
  createdAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, movie, createdAt(sort: Desc)])
}
