# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://movie:movie@localhost:5432/movie_memory?schema=public"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Required for `next start` outside Vercel: set the public URL (preferred) or trust the Host header.
# AUTH_URL="https://movie-memory.example.com"
# AUTH_TRUST_HOST="true"

# OpenAI (server-only; never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=""
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL=""
